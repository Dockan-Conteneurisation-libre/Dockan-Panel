  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vue-tsc": "^3.3.14"
  }
